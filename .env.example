# Printing MCP local configuration.
# Copy this file to .env for local shell usage if desired. Do not commit .env.

# Blender bridge
BLENDER_HOST=localhost
BLENDER_PORT=9876
BLENDER_TIMEOUT_SECONDS=180

# OrcaSlicer / Elegoo Slicer CLI
ORCASLICER_BIN=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
ORCASLICER_DATADIR=
ORCASLICER_TIMEOUT_SECONDS=900

# Elegoo LAN printer
ELEGOO_PRINTER_HOST=
ELEGOO_PRINTER_TYPE=cc2
ELEGOO_ACCESS_CODE=
# Set to 1 only if you intentionally want to try Elegoo's factory LAN token.
ELEGOO_USE_DEFAULT_ACCESS_CODE=0
ELEGOO_SERIAL_NUMBER=
ELEGOO_MAINBOARD_ID=
ELEGOO_TIMEOUT_SECONDS=30
ELEGOO_DISCOVERY_TIMEOUT_SECONDS=8
ELEGOO_UPLOAD_CHUNK_BYTES=1048576

# Local GPU mesh backend (generation_create_mesh provider="local"; see README)
PRINTING_LOCAL_MESH_PYTHON=
# Only for mesh_model="triposr"; hunyuan3d_mini is installed in the GPU Python.
PRINTING_TRIPOSR_DIR=
# Optional: keep model weights (about 10 GB) off the system drive.
# HF_HOME=D:/printing-gen/hf
# HY3DGEN_MODELS=D:/printing-gen/models

# Modal generation backend
PRINTING_GENERATION_MODAL_APP=printing-generation
PRINTING_GENERATION_MAX_IMAGE_COST_USD=0.03
PRINTING_GENERATION_MAX_FAST_MESH_COST_USD=0.08
PRINTING_GENERATION_MAX_QUALITY_MESH_COST_USD=0.22
PRINTING_GENERATION_MAX_WARMUP_COST_USD=0.50
PRINTING_GENERATION_MAX_ARTIFACT_MB=75

# Modal auth for headless use. Leave blank if using `modal token new` locally.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face token is stored in the Modal Secret named `printing-huggingface`,
# not in this file. The required secret key is HF_TOKEN.

# Google Gemini API image generation
# Used by generation_create_image with Nano Banana 2.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted by the Google GenAI SDK.
GOOGLE_API_KEY=
